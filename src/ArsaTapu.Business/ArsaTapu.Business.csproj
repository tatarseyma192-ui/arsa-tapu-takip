    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <!-- Gercek CI hatasindan (2026-08-06) dogrulandi: nuget.org'da yalnizca 2 surum var,
         en yakini "1.7.0-custom-5" (prerelease). Onceki varsayimim (0.1.x) tamamen yanlismis.
         PdfDocument.Open/Page.Letters/Letter.GlyphRectangle gibi TEMEL API'lerin bu surumde de
