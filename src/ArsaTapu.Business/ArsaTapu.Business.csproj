<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ArsaTapu.Business</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <!-- DependencyInjection.cs IServiceCollection/AddScoped/AddSingleton kullanıyor. Daha önce
         yalnızca EF Core/FluentValidation.DependencyInjectionExtensions üzerinden geçişli olarak
         geliyordu; gerçek bağımlılık burada açıkça belirtiliyor. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <!-- DosyaDogrulamaService IConfiguration.GetValue<T>() kullanıyor. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <!-- TkgmParselSorguIstemcisi ILogger<T> kullanıyor (HttpClient BCL'de zaten mevcut). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <!-- EF.Functions.ILike (KisiService/TasinmazService'te kullanılıyor) bu paketten gelir.
         DataAccess projesi üzerinden zaten geçişli (transitive) olarak da gelir; burada
         doğrudan yazılması Business katmanının gerçek bağımlılığını gizlemesin diyedir. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <!-- TasinmazYukleme modülü: PDF/Excel parse (Requirements madde 2, madde 5 - izole modül).
         Sürüm numaraları bu ortamda internet erişimi olmadığı için NuGet.org'a karşı doğrulanamadı;
         `dotnet restore` başarısız olursa en güncel kararlı sürümle değiştirin. -->
    <PackageReference Include="UglyToad.PdfPig" Version="0.1.*" />
    <PackageReference Include="ClosedXML" Version="0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArsaTapu.Domain\ArsaTapu.Domain.csproj" />
    <ProjectReference Include="..\ArsaTapu.Dto\ArsaTapu.Dto.csproj" />
    <ProjectReference Include="..\ArsaTapu.DataAccess\ArsaTapu.DataAccess.csproj" />
  </ItemGroup>

</Project>
