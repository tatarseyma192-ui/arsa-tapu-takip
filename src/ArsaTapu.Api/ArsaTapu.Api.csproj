<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ArsaTapu.Api</RootNamespace>
    <UserSecretsId>arsatapu-takip-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <!-- Program.cs AddHttpClient<IParselSorguIstemcisi,...>() kullanıyor (TKGM entegrasyonu). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <!-- DogrulamaFiltresi doğrudan FluentValidation tiplerini kullanıyor; Business üzerinden
         geçişli (transitive) olarak da gelir, burada açıkça yazılması gerçek bağımlılığı gizlemesin diyedir. -->
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <!-- JwtTokenService doğrudan FirstOrDefaultAsync/SaveChangesAsync kullanıyor. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArsaTapu.Business\ArsaTapu.Business.csproj" />
    <ProjectReference Include="..\ArsaTapu.DataAccess\ArsaTapu.DataAccess.csproj" />
    <ProjectReference Include="..\ArsaTapu.Domain\ArsaTapu.Domain.csproj" />
    <ProjectReference Include="..\ArsaTapu.Dto\ArsaTapu.Dto.csproj" />
  </ItemGroup>

</Project>
