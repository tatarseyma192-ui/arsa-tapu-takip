@page
@model ArsaTapu.Web.Pages.GirisModel
@{
    ViewData["Title"] = "Giriş";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Giriş - Arsa / Tapu Takip</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center" style="min-height:100vh">
    <div class="container" style="max-width:380px">
        <h1 class="h4 mb-4 text-center">Arsa / Tapu Takip</h1>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                @if (Model.HataMesaji is not null)
                {
                    <div class="alert alert-danger py-2">@Model.HataMesaji</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">E-posta</label>
                        <input asp-for="KullaniciAdiVeyaEposta" class="form-control" autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <input asp-for="Sifre" type="password" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
