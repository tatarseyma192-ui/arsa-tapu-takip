<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Arsa / Tapu Takip</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/Kisiler">Arsa / Tapu Takip</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-3 ms-auto">
                    <span class="text-white-50 small">@User.Identity.Name</span>
                    <form method="post" asp-page="/Cikis">
                        <button type="submit" class="btn btn-outline-light btn-sm">Çıkış</button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <div class="container pb-5">
        @if (TempData["Hata"] is string hata)
        {
            <div class="alert alert-danger">@hata</div>
        }
        @if (TempData["Bilgi"] is string bilgi)
        {
            <div class="alert alert-success">@bilgi</div>
        }
        @RenderBody()
    </div>
</body>
</html>
